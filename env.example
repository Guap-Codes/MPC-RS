# Database
DATABASE_URL=sqlite://./mpc_wallet.db

# Bitcoin
MEMPOOL_API_URL=https://mempool.space/api

# Ethereum (anvil)
ETH_RPC_URL=http://127.0.0.1:8545
ETH_CHAIN_ID=31337

#ETH_RPC_URL=https://ethereum-rpc.publicnode.com
#ETH_CHAIN_ID=1

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Tron
TRON_RPC_URL=https://api.trongrid.io

# XRP
XRP_RPC_URL=https://s1.ripple.com:51234
# XRP_NETWORK_ID=1  <-- Uncomment and set to 1 if using Testnet

# Wallet Hierarchy (Required for boot)
MASTER_XPUB=

# MPC Node Registry (Used by Coordinator to route sessions)
NODE_1_URL="https://127.0.0.1:50001"
NODE_1_DOMAIN="node1"

NODE_2_URL="https://127.0.0.1:50002"
NODE_2_DOMAIN="node2"

NODE_3_URL="https://127.0.0.1:50003"
NODE_3_DOMAIN="node3"

# Coordinator Listen Address (Optional, defaults to 0.0.0.0:50052)
# COORDINATOR_LISTEN_ADDR="0.0.0.0:50052"

# Coordinator gRPC Address (Used by Nodes to report signatures)
COORDINATOR_GRPC_URL="https://127.0.0.1:50052"
