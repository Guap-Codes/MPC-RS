# ==========================================
# 1. CRYPTOGRAPHIC SECRETS & SENSITIVE DATA
# ==========================================
# NEVER commit private keys or the Root CA key
config/*-key.pem
config/ca-key.pem
config/*-cert.pem
config/ca-cert.pem  
config/admin-key.pem
config/private.pem
config/*.csr
config/*.srl

# Environment variables containing secrets (RPC keys, DB passwords)
.env
.env.local
.env.*.local

# Local databases (SQLite)
*.db
*.db-shm
*.db-wal
*.sqlite

# Encrypted files
*.enc


# ==========================================
# 2. RUST & BUILD ARTIFACTS
# ==========================================
# Generated by Cargo
/target/
**/target/

# Remove Cargo.lock from gitignore if creating a library (not applicable here, 
# as you have binary targets like mpc-node, mpc-api, so committing Cargo.lock 
# is highly recommended to prevent supply-chain attacks).

# MSVC Windows Rust compilation artifacts
*.pdb

# ==========================================
# 3. IDE & OS GENERATED FILES
# ==========================================
# IntelliJ / RustRover
.idea/
*.iml

# VS Code
.vscode/
*.code-workspace

# macOS
.DS_Store

# Windows
Thumbs.db

# Backup files generated by some editors
**/*.rs.bk
*~


# Ignore local runtime data (SoftHSM databases, SQLite files)
data/

# Ignore Docker
docker/


# Ignore the tests for now
tests/


# Ignore backups
backups/

# Ignore Logs
logs/
